# Airflow Configuration
AIRFLOW_UID=50000
AIRFLOW_GID=0

# Admin user credentials (change these!)
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=your_secure_password

# Project directory
AIRFLOW_PROJ_DIR=.

# Additional pip requirements
_PIP_ADDITIONAL_REQUIREMENTS=

# OCR Service Configuration
OCR_SERVICE_URL=http://ocr-service:8000

# Database Configuration
POSTGRES_USER=airflow
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=airflow

# CTI Pipeline specific paths
CTI_DATA_DIR=./data
CTI_METADATA_DIR=./metadata
CTI_PDF_DIR=./PDFs
CTI_RESULTS_DIR=./results

# API Keys for external services (replace with your keys)
OTX_API_KEY=your_otx_api_key
GROQ_API_KEY=your_groq_api_key
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENROUTER_API_KEY=your_openrouter_api_key