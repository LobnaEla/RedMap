# ==== Environment variables for Airflow ====
# Set this to your user ID on Linux/macOS: $(id -u)
AIRFLOW_UID=50000
AIRFLOW_GID=0
AIRFLOW_PROJ_DIR=./airflow

# Airflow Web UI credentials
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Logging Level
LOG_LEVEL=INFO

# ==== Environment variables for n8n ====
# n8n Configuration
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin123



# ==== Environment variables for CTI Event Service ====
# Event Monitoring Configuration
# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Monitoring Configuration
MONITOR_INTERVAL=300  # seconds (5 minutes)



# Additional pip requirements (add packages here if needed)
# Example: _PIP_ADDITIONAL_REQUIREMENTS=pandas==1.5.0 requests==2.28.0
_PIP_ADDITIONAL_REQUIREMENTS= 

OTX_API_KEY =
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
RAG_API_URL = "http://127.0.0.1:8000/query"
